<?xml version="1.0"?>
<!--
  Top-level drone description. Includes bot.xacro (body/arms/motors/props),
  camera.xacro (RGB camera) and control.xacro (gz-sim control interface).

  Args:
    prefix - link/joint name prefix, e.g. "drone_0_" (default: none)
-->
<robot name="swarm_drone" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix" default=""/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <xacro:include filename="$(find swarm_drone)/urdf/bot.xacro"/>
  <xacro:include filename="$(find swarm_drone)/urdf/camera.xacro"/>
  <xacro:include filename="$(find swarm_drone)/urdf/control.xacro"/>

</robot>
